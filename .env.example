# Copy to .env and adjust. The agent talks to ANY OpenAI-compatible endpoint.
# The defaults in config.py already target local Ollama, so on a Mac you can skip .env.

# --- Local Mac via Ollama (default; see scripts/serve_ollama.sh) ---
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=qwen3:30b-a3b        # same 30B-A3B MoE; use qwen3:8b for lighter iteration

# --- vLLM on a CUDA box (see scripts/serve_vllm.sh) ---
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed
# MODEL=qwen3-30b-a3b

# Agent behaviour
AGENT_MAX_ITERS=8
PREVIEW_ROWS=20
LLM_TEMPERATURE=0.2
LLM_THINK=0                # 1 = let Qwen3 think (slower); 0 = append /no_think
